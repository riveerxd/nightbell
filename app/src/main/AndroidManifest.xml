<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        The URGENT page. CallStyle is demoted to an ordinary notification unless
        the notification is tied to a foreground service or carries a full-screen
        intent, and a page arriving on a locked phone should wake the screen.

        Not pre-granted at targetSdk 34+ for anything but calling and alarm apps,
        so the app must check `canUseFullScreenIntent()` and send the user to
        ACTION_MANAGE_APP_USE_FULL_SCREEN_INTENT — the heads-up has to keep
        working on its own when this is denied.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
        Lets the app ask for a Doze exemption with a system dialog in place,
        rather than sending the user off to hunt through battery settings. Without
        the exemption Android can refuse the foreground service that owns the
        URGENT page and its repeat loop.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        Without this, `NotificationChannel.setBypassDnd(true)` is silently
        dropped and Do Not Disturb mutes the page completely. Declaring it is
        only half the job: the user still has to grant policy access.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
        Strict monitoring runs a foreground service so checks keep their cadence
        in Doze. SPECIAL_USE rather than DATA_SYNC: dataSync is capped at six
        hours a day on API 34+, which would silently break the one guarantee
        strict mode exists to make. The subtype below documents the use.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        Auto Backup is off, deliberately.

        `allowBackup="true"` with `fullBackupContent="true"` and no exclusion rules
        was uploading `datastore/pulse_store.preferences_pb` to the user's Google
        Drive — and that document holds every monitor's request headers, which is
        exactly where an `Authorization: Bearer …` lives. An app whose pitch is
        "no server, no account, no third party" cannot ship its users' API tokens
        to a third party as a side effect of a default.

        Device-to-device transfer is off with it, and that is the right trade
        rather than a casualty: the store also carries in-progress alert
        bookkeeping, and restoring that onto a fresh install is the one thing the
        JSON import path deliberately refuses to do, because inheriting a stale
        "already alerting" flag suppresses the next real outage. Settings →
        Backup and transfer stays the only way across, and it scrubs that state on
        purpose.
    -->
    <!--
        android:icon is a plain drawable, not @mipmap/ic_launcher, and there is no
        roundIcon.

        AdaptiveIconDrawable.draw() fills its layer bitmap with Color.BLACK before it
        composites the background and foreground layers, because the format assumes an
        opaque background. A transparent <background> therefore renders as solid black
        everywhere the framework draws the icon — launcher and Settings' app-info screen
        alike — which is neither a launcher bug nor a stale cache. A transparent app icon
        has to be a legacy one.

        The cost is themed ("monochrome") icons, which only the adaptive format carries.
        ic_launcher_foreground and ic_launcher_monochrome are kept, unused, for whenever
        a plate is wanted back.

        roundIcon goes with it: it only ever pointed at the same adaptive pair, and a
        legacy icon needs no circular variant.
    -->
    <application
        android:name=".PulseApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_mark"
        android:label="@string/app_name"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Pulse">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pulse">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Widget rows deep-link straight to one monitor. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="pulse" android:host="monitor" />
            </intent-filter>
        </activity>

        <!--
            Full-screen-intent target for an URGENT page. `singleInstance` plus
            `excludeFromRecents` so a repeat can never stack a second copy and so
            an emergency surface does not linger in the recents list.
        -->
        <activity
            android:name=".UrgentAlertActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.Pulse" />

        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Pulse">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <service
            android:name=".data.work.PulseMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-configured uptime checks on their exact schedule and repeats an unacknowledged URGENT outage alert until the user confirms it." />
        </service>

        <!--
            Posts a sample URGENT page as a real foreground-service notification,
            because `setColorized` — the only way to have the system paint the
            whole card red — is ignored for anything else. Stops itself.
        -->
        <service
            android:name=".data.alerts.UrgentPagePreviewService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the user what an URGENT outage page will look and sound like before they have to trust it with a real outage." />
        </service>

        <receiver
            android:name=".data.alerts.AlertActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="me.river.pulse.action.RECHECK" />
                <action android:name="me.river.pulse.action.MUTE_1H" />
                <action android:name="me.river.pulse.action.ACK_URGENT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".data.work.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.PulseWidgetProvider"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="me.river.pulse.action.WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pulse_info" />
        </receiver>
    </application>
</manifest>
