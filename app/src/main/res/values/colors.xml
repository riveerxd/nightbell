<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="nightbell_void">#FF06070E</color>
    <color name="nightbell_ink">#FF0B0D18</color>

    <!--
        The mark's ink, in one place because five drawables paint it: the launcher
        icon, the adaptive foreground, the splash icon and the widget header, all
        generated by docs/brand/android_assets.py and all pointing here.

        The debug source set overrides it with yellow (see src/debug/res). A debug
        build installs alongside a release one, because the applicationId carries a
        .debug suffix, so without this the launcher shows two identical bells and
        the only way to tell which is which is to open one.
    -->
    <color name="brand_mark">#FF2F6BFF</color>

    <!--
        The live-update line's tones, resolved per system theme rather than
        hardcoded like the URGENT page's reds.

        The shade is drawn by SystemUI in the *system's* light or dark theme, not
        in whichever one the app was told to use, so these have to come from a
        resource that follows uiMode. These are the light-scheme values, and they
        are the ones 2.3.0 re-picked for the light theme rather than the dark
        palette's: Mint #2FD98A is 1.9:1 on white.
    -->
    <color name="live_up">#FF07834B</color>
    <color name="live_degraded">#FF8A5200</color>
    <color name="live_down">#FFC4111F</color>
    <color name="live_unknown">#FF8B93A3</color>
    <!-- The unelapsed tail. Reads as track rather than as a verdict. -->
    <color name="live_ahead">#FFD5DAE3</color>
    <!--
        The countdown drawn at the end of the line. No container behind it, so it
        has to carry its own contrast against whatever surface the shade uses —
        which is why it follows uiMode like the tones above rather than being a
        fixed ink. Dark slate for the light shade.
    -->
    <color name="live_label">#FF3C424E</color>
</resources>
