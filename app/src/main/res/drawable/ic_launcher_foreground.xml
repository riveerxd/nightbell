<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.aapt.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer radar ring -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.9,26"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="26" android:startY="26"
                android:endX="82" android:endY="82">
                <item android:offset="0" android:color="#B3FFFFFF" />
                <item android:offset="0.5" android:color="#5922E1D0" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- sweeping arc (top-right quadrant highlight) -->
    <path
        android:pathData="M54,20 A34,34 0 0,1 88,54"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="20"
                android:endX="88" android:endY="54">
                <item android:offset="0" android:color="#0022E1D0" />
                <item android:offset="0.55" android:color="#B322E1D0" />
                <item android:offset="1" android:color="#FF7C4DFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- inner ring -->
    <path
        android:pathData="M54,38 A16,16 0 1,1 53.9,38"
        android:strokeWidth="1.4"
        android:fillColor="#00000000"
        android:strokeColor="#3DFFFFFF" />

    <!-- heartbeat / pulse trace -->
    <path
        android:pathData="M22,54 L36,54 L42,42 L50,68 L58,48 L64,58 L70,54 L86,54"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="22" android:startY="54"
                android:endX="86" android:endY="54">
                <item android:offset="0" android:color="#4D6EE7FF" />
                <item android:offset="0.28" android:color="#FF6EE7FF" />
                <item android:offset="0.62" android:color="#FFB388FF" />
                <item android:offset="1" android:color="#4DB388FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- leading pulse dot -->
    <path
        android:pathData="M79,54 A3.4,3.4 0 1,1 78.9,54"
        android:fillColor="#FFFFFFFF" />
</vector>
