# Build output
build/
app/build/
.gradle/
local.properties

# Signing material — regenerate with the command in HANDOFF.md
keystore/*.jks
keystore/keystore.properties

# Scratch
*.log
.idea/
.DS_Store

# Debug APKs are 14 MB each and rebuildable; releases and their R8 mapping
# are kept because a release stack trace is unreadable without the mapping.
artifacts/*-debug.apk
.impeccable/
