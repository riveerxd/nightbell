# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# written by scripts/csp.mjs after every build, installed with that build
/csp.generated.conf
/download-target.generated.conf

# rewritten by `next dev` on every start, and not part of the site
/AGENTS.md

# copied from docs/video by scripts/media.mjs, so the films are in history once
/public/media/nightbell-promo.mp4
/public/media/nightbell-alert-firing.mp4

# the 1440 originals the exports are cut from: 19 MB of PNG nothing on the site
# links to. tools/shots/run.sh takes them again from the app.
/public/screens-hd/

# local runs of the e2e suite
/test-results/
/playwright-report/

# 5 MB, and tools/shots/wallpapers.py draws it again (Cobalt is number 8)
/tools/shots/wallpaper-cobalt.png
