{
  "name": "nightbell-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "The Pulse landing page. Static output, built with Astro.",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "assets:check": "node scripts/sync-assets.mjs --check",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "node scripts/validate.mjs",
    "precompress": "node scripts/precompress.mjs",
    "precompress:check": "node scripts/precompress.mjs --check",
    "download-redirect": "node scripts/gen-download-redirect.mjs",
    "download-redirect:check": "node scripts/gen-download-redirect.mjs --check",
    "downloads": "./deploy/scripts/downloads.sh",
    "verify": "npm run assets:check && npm run screens:check && npm run download-redirect:check && npm run build && npm run validate && npm run precompress",
    "screens": "node scripts/clean-screens.mjs",
    "screens:check": "node scripts/clean-screens.mjs --check"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "parse5": "^8.0.1",
    "sharp": "^0.34.5"
  }
}
