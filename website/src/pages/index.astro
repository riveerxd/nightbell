---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Glyph from '../components/Glyph.astro';
import Section from '../components/Section.astro';
import Trace from '../components/Trace.astro';
import Instrument from '../components/Instrument.astro';
import Shade from '../components/Shade.astro';
import Wizard from '../components/Wizard.astro';
import Escalation from '../components/Escalation.astro';
import PathDiagram from '../components/PathDiagram.astro';
import Player from '../components/Player.astro';
import Footer from '../components/Footer.astro';
import { REPO, RELEASE, CHANNELS, SITE_URL, DOWNLOAD_PATH } from '../../site.config.mjs';
import media from '../media.json';

import pagerShot from '../assets/screens/clean/pager-setup.png';
import widgetTall from '../assets/screens/clean/widget-tall.png';
import widgetWide from '../assets/screens/clean/widget-wide.png';
import widgetFlat from '../assets/screens/clean/widget-flat.png';

const apkMb = (RELEASE.apkBytes / 1024 / 1024).toFixed(2);

/**
 * Media facts, measured by scripts/sync-assets.mjs rather than typed here.
 * The promo went from 55.5 s to 40 s while this page was being built, so a
 * hand-written "55 seconds" in a caption was already wrong once.
 */
const abs = (p: string) => new URL(p, SITE_URL).href;

/**
 * The FAQ, once. The list below renders the visible section and the FAQPage
 * structured data, so an answer cannot be edited in one and left stale in the
 * other. Every answer here is one the repository can be checked against.
 */
const faqs: { q: string; a: string }[] = [
  {
    q: 'Does it keep checking when my phone is off?',
    a: 'No. The checks run on the phone, so a phone that is off, out of signal or in flight mode is a monitor that is not checking. That is the honest cost of having no server. If you need something watching while the phone is in a drawer, you need a machine that stays awake, and Nightbell is the wrong tool.',
  },
  {
    q: 'Can it check more often than every 15 minutes?',
    a: 'Only in strict mode. Android’s PeriodicWorkRequest has a hard 15 minute minimum and WorkManager silently clamps anything shorter, so Nightbell clamps it visibly instead and says so in Settings under Checker health. Turning on strict foreground monitoring runs a foreground service that keeps your interval exactly, down to about 15 seconds. It costs a permanent notification and real battery, which is Android’s price for a real cadence and not a design choice.',
  },
  {
    q: 'Is it on F-Droid?',
    a: 'Yes, since 13 August 2026, and that is the install worth taking because it is the only one that updates itself. It is also a reproducible build: F-Droid compiles Nightbell from this source on their own machines, compares the result against the APK attached to the GitHub release, and publishes mine only because the two match byte for byte. So the F-Droid download and the direct download carry the same signature, which means either one updates the other and you can move between them without uninstalling and losing your monitors. IzzyOnDroid is a separate repository and Nightbell is not in it.',
  },
  {
    q: 'Why is it not on the Play Store?',
    a: 'There is no Play listing, and F-Droid covers the reason most people want one: a store client that installs it and keeps it updated. What keeps it off Play is the foreground service, which declares specialUse rather than dataSync, because dataSync is capped at six hours a day from API 34 and that cap would quietly break the one guarantee strict mode exists to make. Shipping it through Play review would mean justifying the subtype. Neither F-Droid nor a direct APK is affected, and both are signed with my own key, so a direct install makes Play Protect ask you to confirm the first time.',
  },
  {
    q: 'Does anything leave my phone?',
    a: 'The check itself, to the service you pointed it at. Nothing else. There is no analytics library, no crash reporter and no backend in the dependency list, the permission list is short enough to read in one go, and site icons are fetched from the monitored origin rather than through an icon proxy. Your service sees the request and your IP, the same as any other client on your network would. What never happens is a third party seeing your tokens, your URLs or your uptime history.',
  },
  {
    q: 'Can I watch something on my home network, or over plain HTTP?',
    a: 'Yes. Cleartext traffic is allowed on purpose, so a box on your LAN answering on http:// is a valid target. The catch is the same one everywhere else: the check comes from the phone, so the phone has to be able to reach the host. A monitor on a LAN address stops passing the moment you leave the house, which is a true fact about your network rather than a bug.',
  },
  {
    q: 'What happens to my monitors when I update?',
    a: 'Anything from 3.0.1 onward installs over the top and keeps your monitors, history and settings. 3.0.0 is the exception: 3.0.1 is signed with a new key, because the old certificate’s subject still carried the previous name and a subject cannot be edited, so a 3.0.0 install has to be uninstalled rather than updated. Coming from Pulse 2.x is different again: 3.0.0 renamed the app and moved its application id, which Android treats as a different app entirely, so it installs beside the old one with an empty data directory rather than upgrading it. The route across is Settings, Backup and transfer in 2.4.3, then import on the new install. Export before uninstalling anything, because once the old app is gone so is its data. Placed widgets and your notification channel settings do not come across either.',
  },
  {
    q: 'How is this different from UptimeRobot or Uptime Kuma?',
    a: 'Both are better than Nightbell at being a monitoring service: they keep watching when your phone is in a drawer, they hold years of history, they have status pages. Nightbell is not trying to win that. It is trying to be the thing that wakes you at 3am without a subscription, a server or an account, by running on hardware you already carry and paging you with a local alarm instead of a push notification. If you already run Uptime Kuma, Nightbell is a reasonable pager to put in front of it.',
  },
  {
    q: 'Will the alarm really get through Do Not Disturb?',
    a: 'Once you grant Do Not Disturb access, yes: urgent alerts go to a dedicated DND bypassing alarm channel. One thing to know first, because it is the current known bug rather than a feature: quiet hours still suppress urgent pages unless you turn on the bypass. That default is wrong and is the next thing on my list, with a migration rather than a flipped constant.',
  },
  {
    q: 'What does it do to my battery?',
    a: 'With the default WorkManager scheduling, close to nothing. Strict foreground monitoring costs real battery, because it wakes for every due check instead of letting Android batch them, and it holds a permanent notification while it does. An unacknowledged urgent outage starts that same service on its own regardless of the setting, and stops it the moment you acknowledge or the monitor recovers.',
  },
  {
    q: 'Is it actually free?',
    a: 'Apache 2.0, the whole thing, source included. No paid tier, no account, no upsell, nothing to cancel. Same licence as everything it depends on, so forking it or lifting a piece of it is straightforward. Keep the notice and say what you changed.',
  },
];

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': abs('/#faq'),
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/**
 * `m:ss` as an ISO 8601 duration, for the `datetime` attribute on each transcript
 * timestamp.
 *
 * `<time>` requires its text to be a valid date, time or duration unless it carries
 * `datetime`, and "0:01" is none of those: the W3C validator rejected all seven.
 * The visible text stays `0:01`, which is what a reader wants, and the attribute
 * carries `PT1S`, which is what a parser wants. These are offsets into the film
 * rather than times of day, so a duration is the correct form.
 */
const isoOffset = (t: string): string => {
  const [m, s] = t.split(':').map(Number);
  return `PT${(m || 0) * 60 + (s || 0)}S`;
};

/** The transcript, in the order the video says it. Same source as the VTT. */
const transcript: { t: string; s: string }[] = [
  { t: '0:01', s: 'Most uptime alerts are one more notification you swipe away.' },
  { t: '0:05', s: 'Nightbell runs entirely on your Android phone. No server, no account, no third party.' },
  { t: '0:12', s: 'Four steps to add a monitor. Point it at anything that answers over HTTP.' },
  { t: '0:17', s: 'Every check runs on the phone. Your tokens never touch a third party.' },
  { t: '0:23', s: 'When a check fails, Nightbell doesn’t send you something you can miss.' },
  { t: '0:28', s: 'It takes the whole screen, and the alarm loops until you acknowledge it.' },
  {
    t: '0:33',
    s: 'Nightbell. The uptime monitor that needs no server, no account, and actually wakes you up.',
  },
];
---

<Base video={true}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqPage)} />

  {/*
    `data-here` is where motion.ts writes the section you are in and the state
    colour that section is about, and the rule along the bottom edge is how far
    through the document you have scrolled. It is the only navigation aid on a
    page this long, so it runs at reduced motion too.
  */}
  <header class="masthead" data-here="top">
    <div class="wrap">
      <a class="brand" href="#top"><Mark size={22} />Nightbell</a>

      <p class="here" aria-hidden="true">
        <span class="here-no" data-here-no>00</span>
        <span class="here-name label" data-here-name>Top</span>
      </p>

      <nav aria-label="Sections">
        <a href="#why">Why</a>
        <a class="only-mid" href="#watch">What it watches</a>
        <a class="only-wide" href="#urgent">Urgent alerts</a>
        <a class="only-wide" href="#limits">Limits</a>
        <a href="#install">Install</a>
        <a href={REPO.url} target="_blank" rel="noopener">GitHub</a>
      </nav>
    </div>
    <span class="progress" data-progress aria-hidden="true"></span>
  </header>

  <main id="main">
    <!-- ============================================================ 01 hero -->
    <section id="top" class="section hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-copy">
            {/*
              The eyebrow is metadata and nothing else: platform, licence,
              version. It used to open with "On-device uptime monitoring", which
              the headline says again two lines later and the lede said a third
              time, so the first thing a stranger read was the same sentence
              three times in three registers.
            */}
            <p class="label eyebrow">
              <Glyph name="activity" size={14} />Android &middot; Apache 2.0 &middot; v{RELEASE.version}
            </p>
            <h1>The uptime monitor that actually wakes you up.</h1>
            <p class="lede">
              An open-source Android app that runs every check from the phone in your pocket.
            </p>

            {/*
              The CTA is above the rules, not under them.

              It used to be the fifth block down, after a five line headline, a
              five line lede and three rules, which put the APK button under the
              fold of a 1440 by 900 laptop and off a phone entirely. On a page
              whose entire job is handing over a 2 MB file, the download was the
              one thing you had to scroll to find.

              Claim, one line of what it is, the button, then the evidence. The
              rules below are corroboration, and corroboration reads fine after
              the ask.
            */}
            {/*
              Three buttons on one row, so the labels lose their articles:
              "Download APK", not "Download the APK". At 1440 the row has space
              either way, but at 390 a third button plus two "the"s wraps the row
              onto three lines and the ask stops looking like one decision.
            */}
            {/*
              href is /download, not the GitHub URL, and it is the only link on
              the page with no target="_blank". Both are deliberate: see
              DOWNLOAD_PATH in site.config.mjs for why the click goes through this
              origin, and the note on the second button for why the tab stays.
            */}
            <div class="actions">
              <a class="btn btn-primary" href={DOWNLOAD_PATH}>
                <Glyph name="download" size={17} />
                Download APK
                <span class="mono apk-size">{apkMb} MB</span>
              </a>
              <a class="btn btn-ghost" href={REPO.url} target="_blank" rel="noopener">
                <Glyph name="book" size={17} />
                Read source
              </a>
              {/*
                The repository root, not /stargazers. GitHub has no anonymous
                "star this" URL, and the stargazers page 404s for a signed-out
                visitor on a repo with no stars yet, which is exactly who this
                button is for. So it lands on the page where the Star control
                actually is. Same href as "Read source" on purpose: two intents,
                one destination, and neither of them a dead end.
              */}
              <a class="btn btn-ghost" href={REPO.url} target="_blank" rel="noopener">
                <Glyph name="star" size={17} />
                Star on GitHub
              </a>
            </div>

            {/*
              Three claims on rules, not three cards, and these three rules are
              now the only place any of them is stated.

              This was a two by two of rounded cards, each with a tinted icon
              tile and a coloured glow under it, and the fourth of them was a
              specimen alert drawn in the same shape as the three claims above
              it. That shape is the one every generated landing page reaches
              for, DESIGN_NOTES refuses the version of it in section 04 for the
              reason that applies here too, and putting "Checkout API is down"
              in a box next to "No server path" files an incident as a bullet.

              The alert is gone from here entirely. The panel in the next column
              is a real one arriving off real bars, which is the same claim made
              by demonstration, and making it twice weakened it once.

              The term and its explanation stack rather than sitting at opposite
              edges of the column. Right aligning the explanation put 200 px of
              nothing between a label and the words that finish it, gave three
              hairlined rows the shape of a pricing table, and the explanation
              is the interesting half. It reads left, under the label, where the
              eye already is.
            */}
            <dl class="hero-proof">
              <div>
                <dt><Glyph name="globe" size={17} />No server path</dt>
                <dd>Phone → your service → phone</dd>
              </div>
              <div>
                <dt><Glyph name="shield" size={17} />Tokens stay local</dt>
                <dd>No account. Headers and history live on the device.</dd>
              </div>
              <div>
                <dt><Glyph name="bell" size={17} />Alarm, not a ping</dt>
                <dd>Full-screen page that loops until you acknowledge it</dd>
              </div>
            </dl>

            <p class="hero-facts label">
              <span><Glyph name="power" size={13} />Android {RELEASE.minAndroid} and up</span>
              <span><Glyph name="arrowRight" size={13} />On F-Droid, not on Play</span>
            </p>
          </div>

          {/*
            The readout is on a phone, because it is a phone app.

            Off the frame it was a dark rounded card holding a bar chart, a
            status pill and a four up stat row, which is the exact furniture
            Grafana, Pingdom and every hosted checker ships. So the fold argued
            "no server" in type while the only picture on it said "server
            dashboard", and nothing above the fold said the word phone at all.

            Same four rings as every other device on the page, from the same
            rule, so this is the page's existing shell around live markup rather
            than a second way of drawing a phone.
          */}
          <div class="hero-device">
            <div class="device device-live">
              <Instrument />
            </div>
          </div>
        </div>

        {/*
          The promo gets a band of its own at page width rather than a slot in
          the hero beside a wall of body copy. It is the only forty seconds that
          shows the app moving, and shrinking it into a column would be spending
          the best asset this project has on a decoration.

          It has no heading and no standfirst. A poster frame with a play button
          on it does not need a label reading "The forty second version" and a
          sentence listing the four things you are about to watch, and the
          chapter row under the scrubber already names all four.
        */}
        <div class="film" data-reveal>
          <Player
            id="promo"
            src={media.promo.file}
            poster="/media/nightbell-promo-poster.webp"
            seconds={media.promo.seconds}
            bytes={media.promo.bytes}
            captions="/media/nightbell-promo.en.vtt"
            chapters={media.promo.chapters}
            label="The Nightbell promo: the mark, monitoring on your phone, the four-step wizard, checks running on the device, the alert firing, and where to get it."
            note="Forty seconds. Watch it with the sound off if you like, the captions are on the CC button."
          />

          <details class="transcript">
            <summary><Glyph name="book" size={15} />Read the video transcript</summary>
            <div class="body">
              <ol>
                {
                  transcript.map((line) => (
                    <li>
                      <time datetime={isoOffset(line.t)}>{line.t}</time>
                      <span>{line.s}</span>
                    </li>
                  ))
                }
              </ol>
            </div>
          </details>
        </div>
      </div>
    </section>

    <Trace variant="calm" state="brand" seed={1} />

    <!-- ============================================================= 02 why -->
    <Section id="why" no="02" rail="Why it exists" state="quiet">
      <div class="section-head">
        <p class="label eyebrow"><Glyph name="info" size={14} />The problem</p>
        <h2>A notification you can swipe away is not an alert.</h2>
      </div>

      <Shade />

      {/*
        One line, and the rest folded away.

        This was a paragraph, then a details holding two more, then another
        paragraph introducing the table: four blocks of prose to make a point the
        two cards above have already made by moving. Nobody reads a wall of
        reasoning under a demonstration of the same thing.

        Nothing was deleted. `<details>` content is in the markup and indexed like
        any other text, so the long version is still here for a crawler and for
        anyone who wants it, and the summary says which it is rather than
        addressing crawlers out loud the way the old one did.
      */}
      <div class="prose compact-copy" style="margin-top:2.5rem">
        <p>
          Checking a URL has been a solved problem for twenty years. The hard part is the last ten
          centimetres, between a server that knows and a person who is asleep.
        </p>
        <details class="deep-cut">
          <summary><Glyph name="book" size={15} />Why I built it instead of paying for one</summary>
          <p>
            I kept missing outages because ordinary monitoring notifications behaved like
            everything else in the shade. The services I tried either wanted a subscription before
            they would text me, or sent something that looked exactly like a marketing email and
            got swiped away with one. By the time I noticed, the interesting part of the incident
            was over.
          </p>
          <p>
            The hard part is alerting without crying wolf. An outage on an urgent monitor is not a
            line in the shade. It behaves like an incoming call, and everything else in the app
            exists to earn the right to do that.
          </p>
        </details>
      </div>

      {/* A scrollable region needs to be reachable by keyboard, hence the
          tabindex and the label. The caption names the table for a screen
          reader; the sentence above explains it to everyone else, and lives
          outside the scroller so it is readable without scrolling. */}
      <div class="table-scroll" tabindex="0" role="region" aria-label="Hosted, self-hosted and Nightbell compared">
        <table class="compare">
          <caption class="sr-only">
            Hosted monitoring, self-hosted monitoring and Nightbell compared across six aspects
          </caption>
          <thead>
            {/*
              The examples are in the headers rather than in a sentence above the
              table. "Hosted means something like UptimeRobot; self-hosted means
              something like Uptime Kuma" was a line of prose whose only job was
              telling you what two of the three columns are, which is a thing a
              column heading can do itself, in place, where you are looking.
            */}
            <tr>
              <th scope="col"><span class="sr-only">Aspect</span></th>
              <th scope="col">
                <span class="th-name"><Glyph name="globe" size={14} />Hosted service</span>
                <span class="th-eg">like UptimeRobot</span>
              </th>
              <th scope="col">
                <span class="th-name"><Glyph name="server" size={14} />Self-hosted</span>
                <span class="th-eg">like Uptime Kuma</span>
              </th>
              <th scope="col" class="is-nightbell">
                <span class="th-name"><Glyph name="activity" size={14} />Nightbell</span>
                <span class="th-eg">on your own phone</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Infrastructure</th>
              <td>Theirs. Nothing to run.</td>
              <td>A box, a container, a certificate, and monitoring for the monitor.</td>
              <td class="is-nightbell">The phone you already carry.</td>
            </tr>
            <tr>
              <th scope="row">Account</th>
              <td>Required.</td>
              <td>Usually required, at least locally.</td>
              <td class="is-nightbell">None. There is nothing to sign up to.</td>
            </tr>
            <tr>
              <th scope="row">Where tokens sit</th>
              <td>On their servers.</td>
              <td>On your server.</td>
              <td class="is-nightbell">On the device, in one JSON document.</td>
            </tr>
            <tr>
              <th scope="row">Paging you</th>
              <td>Usually the paid tier.</td>
              <td>Yours to build, on top of a push service.</td>
              <td class="is-nightbell">A local alarm, so there is nothing to bill for.</td>
            </tr>
            <tr>
              <th scope="row">At 3am you get</th>
              <td>An email or a push notification.</td>
              <td>Whatever you wired up.</td>
              <td class="is-nightbell">
                A full-screen page and an alarm that loops until you acknowledge it.
              </td>
            </tr>
            <tr>
              <th scope="row">It cannot</th>
              <td>Fail quietly. You will get a bill.</td>
              <td>Watch itself.</td>
              <td class="is-nightbell">
                Check while the phone is off, or beat Android's 15 minute background floor without a
                foreground service.
              </td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="label scroll-hint"><Glyph name="arrowRight" size={13} />Scroll the table sideways for the Nightbell column</p>
    </Section>

    <Trace variant="calm" seed={2} />

    <!-- ======================================================= 03 on device -->
    <Section id="on-device" no="03" rail="On the device">
      <div class="section-head">
        <p class="label eyebrow"><Glyph name="server" size={14} />How a check runs</p>
        <h2>The check leaves your phone and goes to your service. That is the entire path.</h2>
      </div>

      <PathDiagram />

      {/*
        An inventory, not a triptych.

        This was three articles in a bordered row, each an icon tile over a heading
        over a sentence: the shape every generated page ships, and the one the
        refused list names. Worse than the shape was the content. The diagram
        directly above already draws the request going to your service and back, the
        crossed-out monitoring company, and "state stays here: one JSON document in
        DataStore". The three cards said those same three things again in prose, and
        two of them were the hero's rules for a third time.

        So the cards say something the diagram cannot. A diagram can draw what the
        path is; it cannot list what is absent from the dependency graph, and that
        list is the actual claim: every one of these is a thing a monitoring app
        normally has, all of them are checkable against the repository, and none of
        them is there.
      */}
      <div class="absent" data-reveal>
        <p class="label absent-head">
          <Glyph name="close" size={14} />Not in the path, and not in the dependency list
        </p>
        <ul aria-label="Components Nightbell does not have">
          <li>relay</li>
          <li>queue</li>
          <li>worker</li>
          <li>backend</li>
          <li>account</li>
          <li>push service</li>
          <li>analytics SDK</li>
          <li>crash reporter</li>
          <li>icon proxy</li>
        </ul>
        <p class="absent-note">
          What it does not buy you is anonymity from the thing you are watching. Your service sees
          the request and the IP it came from, exactly as it would for any other client on your
          network. That is what a check is. Routing a monitor through your own proxy is the one
          thing that changes it, and only for that monitor.
        </p>
      </div>

      <details class="deep-cut prose" style="margin-top:2rem">
        <summary><Glyph name="braces" size={15} />Implementation details</summary>
        <p>
          A status or request monitor is an OkHttp call from your phone to the host you typed in. A
          page-element monitor loads the page in an offscreen WebView on the same phone and reads
          the DOM nodes you picked by tapping them. There is no relay, no queue and no worker
          somewhere else, because there is nowhere else. The one exception is a hop you set up
          yourself: a monitor can be routed through a SOCKS5 proxy running on your own device,
          which is how a Tor or I2P hidden service gets checked. It goes where you point it and
          nowhere else, and it is off until you turn it on.
        </p>
        <p>
          Everything the app knows lives in one JSON document in DataStore: your monitors, their
          headers and bodies, their sample history and your settings. Backup and transfer writes
          that document through the Storage Access Framework, which is why Nightbell asks for no
          storage permission and why you choose where the file goes. Nothing is uploaded, and there
          is no import path that could reach anything you did not hand it.
        </p>

        <h3>What that does and does not buy you</h3>
        <p>
          It buys you this: an API token in a monitor's headers is on your phone and on your
          server, and nowhere in between. No third party can leak it, subpoena it, or change its
          terms of service. There is no analytics library, no crash reporter and no backend in the
          dependency list, and site icons are fetched from the monitored origin itself rather than
          through an icon proxy.
        </p>
        <p>
          It does not buy you anonymity from the thing you are watching. Your service sees the
          request and the IP it came from, exactly as it would for any other client on your
          network. That is what a check is.
        </p>
      </details>
    </Section>

    <Trace variant="calm" state="up" seed={3} />

    <!-- ============================================================ 04 what -->
    <Section id="watch" no="04" rail="What it watches" state="up">
      <div class="section-head">
        <p class="label eyebrow"><Glyph name="radar" size={14} />Three kinds of check</p>
        <h2>Point it at a status code, a response body, or one element on a rendered page.</h2>
      </div>

      <div class="spec">
        <article class="spec-row">
          <div class="spec-kind">
            <span class="spec-glyph" aria-hidden="true"><Glyph name="activity" size={18} /></span>
            <h3>Status check</h3>
            <p class="label">The cheap one</p>
          </div>
          <div>
            <p>
              Hit a URL, assert on the status code. Four modes, because "is it up" means different
