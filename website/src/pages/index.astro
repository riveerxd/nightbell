  <script>
    /*
      The page's JavaScript, all of it, and the page works without every line.

      The player script removes the native controls only once it is certain it
      can replace them, so a failed load leaves a working `<video controls>`
      rather than a poster nobody can press. Every animation in motion.ts is
      written the same way round: the document ships the finished state, and
      script is what temporarily hides it in order to replay how it got there.
      The copy button stays hidden unless the clipboard API is there to back it.
    */
    import { enhancePlayers } from '../scripts/player';
    import { enhanceMotion } from '../scripts/motion';

    enhancePlayers();
    enhanceMotion();

    /*
      Every copy button, not the first one.

      This used to be `querySelector`, which was right when the only thing worth
      copying was the adb line. The two hashes in the fingerprint block each have
      one now, and a 64 character hex string is the single best argument for a
      copy button on this page: it exists to be compared against another one.

      Only the word changes. The glyph beside it is a sibling of this span rather
      than a child of the button's text, so confirming the copy cannot wipe the
      icon out of the button.
    */
    /*
      The last resort, for a clipboard that refuses.

      `writeText` rejects rather than throwing, and it rejects for reasons that
      have nothing to do with this page: an insecure context, a document that is
      not focused, an iframe without the permission. Unhandled, the confirmation
      never ran and the reader was told nothing at all, which on a page whose
      copy buttons exist to compare two hashes is the worst of the three
      outcomes.
    */
    const copyByCommand = (text: string): boolean => {
      const pen = document.createElement('textarea');
      pen.value = text;
      pen.setAttribute('readonly', '');
      pen.style.position = 'fixed';
      pen.style.top = '0';
      pen.style.opacity = '0';
      document.body.append(pen);
      pen.select();
      let done = false;
      try {
        done = document.execCommand('copy');
      } catch {
        done = false;
      }
      pen.remove();
      return done;
    };

    if (navigator.clipboard) {
      for (const button of document.querySelectorAll<HTMLButtonElement>('.copy')) {
        const word = button.querySelector<HTMLElement>('[data-copy-text]');
        if (!word) continue;
        /*
          The resting label is read once, here, and the timer belongs to the
          button rather than to the click.

          Read inside the handler it was whatever the label said at the time, so
          a second press while the first was still confirming saved "Copied" as
          the word to go back to and the button then read Copied for good, which
          is a copy button that has stopped reporting anything.
        */
        const idle = word.textContent ?? 'Copy';
        let back = 0;
        button.hidden = false;
        button.addEventListener('click', async () => {
          const value = button.dataset.copy ?? '';
          let done = true;
          try {
            await navigator.clipboard.writeText(value);
          } catch {
            done = copyByCommand(value);
          }
          window.clearTimeout(back);
          // The value is on the page either way, so the failure says which of
          // the two happened instead of confirming something that did not.
          word.textContent = done ? 'Copied' : 'Copy it by hand';
          back = window.setTimeout(() => {
            word.textContent = idle;
          }, 2000);
        });
      }
    }
  </script>
</Base>
